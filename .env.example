RCLONE_RUNNER_HOST_PORT=8000
TZ=Europe/Helsinki

RCLONE_RUNNER_ADMIN_USER=admin
# Generate with:
# uv run python -c "from app.auth import hash_password; print(hash_password('change-me'))"
RCLONE_RUNNER_ADMIN_PASSWORD_HASH=
RCLONE_RUNNER_SECRET_KEY=change-this-long-random-string

RCLONE_RUNNER_DATA_DIR=/data
RCLONE_RUNNER_LOG_DIR=/data/logs
RCLONE_RUNNER_DATABASE_URL=sqlite:////data/rclone-runner.db
RCLONE_RUNNER_TIMEZONE=Europe/Helsinki
RCLONE_RUNNER_RETENTION_DAYS=30

RCLONE_CONFIG=/config/rclone/rclone.conf

# Local development defaults. Replace with TrueNAS dataset paths in deployment.
RCLONE_RUNNER_DATA_PATH=./data
RCLONE_RUNNER_RCLONE_CONFIG_PATH=./rclone-config
RCLONE_RUNNER_MEDIA_PATH=/mnt/tank/media
